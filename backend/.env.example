# Ключ, который вы указали в Lava.top при создании webhook
# (аутентификация «API key вашего сервиса» → заголовок X-Api-Key).
LAVA_WEBHOOK_SECRET=

# Ключ API из кабинета Lava.top (Интеграции → API). Его читает сайт,
# чтобы создать счёт с возвратом на /?payment=success. Тот же ключ нужен
# в переменных окружения Next.js, не только у этого вебхука.
LAVA_API_KEY=

# UUID офферов / продуктов из кабинета Lava.top, через запятую.
# Экспресс можно не задавать: он бесплатный, оплата не требуется.
# Те же LAVA_OFFER_* читает сайт, когда создаёт счёт: tier=full или tier=developer.
# После оплаты Lava возвращает на /?payment=success&tier=full|developer.
LAVA_OFFER_FULL=
LAVA_OFFER_DEVELOPERS=
LAVA_PRODUCT_FULL=
LAVA_PRODUCT_DEVELOPERS=

# Публичные id Web-Widget из кабинета Lava.top (Интеграции → Web-Widget).
# Это UUID из src="https://widget.lava.top/<uuid>", не id продукта.
# Задаются в Vercel как NEXT_PUBLIC_*, отдельно для каждого тарифа.
# Домен сайта должен быть одобрен, иначе виджет не откроется.
NEXT_PUBLIC_LAVA_WIDGET_FULL=
NEXT_PUBLIC_LAVA_WIDGET_DEVELOPER=

# Postgres сайта (та же DATABASE_URL, что у Next.js / Supabase). Если задана —
# оплата пишется в payments, подписка «Для застройщиков» — в subscriptions
# (email + subscription_id Lava.top, без id аккаунта).
# Отмена поддержкой: POST /api/subscriptions/cancel с тем же X-Api-Key
# и телом {"email":"..."} или {"subscription_id":"..."}.
DATABASE_URL=

# Локальный файл, если DATABASE_URL нет.
PAYMENTS_DB_PATH=payments.db

# Временные ссылки /report/{token} и письмо с отчётом.
SITE_URL=http://localhost:3000
RESEND_API_KEY=
EMAIL_FROM=СтройАудит.ai <reports@stroyaudit.ai>
# Если RESEND_API_KEY пуст, письмо уходит по SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Чат по отчёту вызывает Gemini через OpenRouter.
OPENROUTER_API_KEY=
CHAT_MODEL=google/gemini-2.5-pro
